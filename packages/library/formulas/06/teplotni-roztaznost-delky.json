      }
    },
    {
      "given": {
        "α_t": "23e-6 1/K",
        "L_0": "2 m",
        "ΔT": "50 K"
      },
      "expect": {
        "ΔL": "2.3 mm"
      }
    }
  ],
  "keywords": {
