{
  "name": "@kalketa/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Kalketa as a standalone desktop application (Electron).",
  "author": "Jan Vaník",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "node ../../scripts/pyodide-packages.mjs && electron-builder --win",
    "dist:linux": "node ../../scripts/pyodide-packages.mjs && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "homepage": "https://github.com/janvanik123456789-del/kalketa",
  "desktopName": "kalketa.desktop",
  "build": {
    "appId": "cz.kalketa.desktop",
    "productName": "Kalketa",
    "electronVersion": "44.4.5",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json",
      "!**/node_modules/@napi-rs/**"
    ],
    "asarUnpack": [
      "**/node_modules/pyodide/**"
    ],
    "extraResources": [
      {
        "from": "../editor/dist",
        "to": "editor"
      },
      {
        "from": "pyodide-packages",
        "to": "pyodide-packages"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "fileAssociations": [
      {
        "ext": "kalk",
        "name": "Kalketa",
        "description": "Kalketa calculation",
        "role": "Editor",
        "mimeType": "application/x-kalketa"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kalketa"
    },
    "portable": {
      "artifactName": "Kalketa-${version}-portable.exe"
    },
    "deb": {
      "packageName": "kalketa",
      "artifactName": "kalketa_${version}_${arch}.${ext}",
      "maintainer": "Jan Vaník <347867514+janvanik123456789-del@users.noreply.github.com>",
      "packageCategory": "science"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Science",
      "synopsis": "Engineering calculations with units, tables and print",
      "executableName": "kalketa"
    },
    "appImage": {
      "artifactName": "Kalketa-${version}-x86_64.AppImage"
    },
    "extraFiles": [
      {
        "from": "../editor/src/generated/third-party-notices.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ]
  },
  "dependencies": {
    "@kalketa/ai": "*",
    "pdfjs-dist": "^6.4.299",
    "pyodide": "314.0.7"
  },
  "license": "MIT"
}
