{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "@kalketa/core": [
        "./packages/core/src/index.ts"
      ],
      "@kalketa/i18n": [
        "./packages/i18n/src/index.ts"
      ],
      "@kalketa/sheet": [
        "./packages/sheet/src/index.ts"
      ],
      "@kalketa/render": [
        "./packages/render/src/index.ts"
      ],
      "@kalketa/canvas": [
        "./packages/canvas/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "tests",
    "reference"
  ],
  "exclude": [
    "packages/editor/src",
    "packages/canvas/src/editor"
  ]
}
