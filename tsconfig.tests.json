{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "types": [
      "node"
    ],
    "paths": {
      "@calccanvas/core": [
        "./packages/core/src/index.ts"
      ],
      "@calccanvas/i18n": [
        "./packages/i18n/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "tests",
    "reference"
  ]
}
